generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Department {
    id         String     @id @default(uuid()) @db.Uuid // รหัสแผนก (UUID)
    name       String     @unique // ชื่อแผนก
    createdAt  DateTime   @default(now()) @map("created_at") // วันที่สร้าง
    updatedAt  DateTime   @updatedAt @map("updated_at") // วันที่แก้ไขล่าสุด
    users      User[] // รายชื่อผู้ใช้ในแผนก (พนักงาน/นักศึกษา)
    activities Activity[] // รายการกิจกรรมของแผนก
    majors     Major[] // รายชื่อสาขาในแผนก
    @@map("departments")
}

model Major{
    id           String     @id @default(uuid()) @db.Uuid // รหัสสาขา (UUID)
    name         String     @unique // ชื่อสาขา
    departmentId String     @map("department_id") @db.Uuid // รหัสแผนกที่สาขานี้สังกัด
    department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade) // ข้อมูลแผนกที่สาขานี้สังกัด
    createdAt    DateTime   @default(now()) @map("created_at") // วันที่สร้าง
    updatedAt    DateTime   @updatedAt @map("updated_at") // วันที่แก้ไขล่าสุด
    users        User[] // รายชื่อผู้ใช้ในสาขา (นักศึกษา)
    activities   Activity[] // รายการกิจกรรมของสาขา
    @@index([departmentId])

    @@map("majors")
}

model User {
    id           String       @id @default(uuid()) @db.Uuid // รหัสผู้ใช้ (UUID)
    studentId    String?      @unique @map("student_id") // รหัสนักศึกษา (สำหรับนักศึกษาเท่านั้น)
    fullname     String // ชื่อ-นามสกุล
    email        String       @unique // อีเมล
    password     String? // รหัสผ่าน (สำหรับพนักงาน)
    phone        String? // เบอร์โทรศัพท์
    majorId      String?      @map("major_id") @db.Uuid // รหัสสาขาที่สังกัด
    major        Major?       @relation(fields: [majorId], references: [id], onDelete: SetNull, onUpdate: Cascade) // ข้อมูลสาขาที่สังกัด
    userType     UserType     @map("user_type") // ประเภทผู้ใช้ (admin/teacher/student)
    birthday     String? // วันเกิด (พศ) - สำหรับนักศึกษา
    level        String? // ระดับการศึกษา - สำหรับนักศึกษา
    profilePic   String?      @map("profile_pic") // รูปโปรไฟล์
    status       UserStatus   @default(active) // สถานะผู้ใช้
    createdAt    DateTime     @default(now()) @map("created_at") // วันที่สร้าง
    updatedAt    DateTime     @updatedAt @map("updated_at") // วันที่แก้ไขล่าสุด
    activities   Activity[]   // กิจกรรมที่รับผิดชอบ (สำหรับพนักงาน)
    attendances  Attendance[] // ข้อมูลการเข้าร่วมกิจกรรม (สำหรับนักศึกษา)

    @@index([majorId])
    @@index([userType])
    @@index([status])
    @@index([email])
    @@index([studentId])
    @@map("users")
}

model TypeActivity {
    id         String   @id @default(uuid()) @db.Uuid // รหัสประเภทกิจกรรม (UUID)
    name       String   @unique // ชื่อประเภทกิจกรรม
    createdAt  DateTime @default(now()) @map("created_at") // วันที่สร้าง
    updatedAt  DateTime @updatedAt @map("updated_at") // วันที่แก้ไขล่าสุด
    activities Activity[] // รายการกิจกรรมที่ใช้ประเภทนี้

    @@map("type_activities")
}

model MajorJoinActivity {
    id         String   @id @default(uuid()) @db.Uuid // รหัสการเชื่อมโยงสาขากับกิจกรรม (UUID)
    majorId    String   @map("major_id") @db.Uuid // รหัสสาขา
    activityId String   @map("activity_id") @db.Uuid // รหัสกิจกรรม
    major      Major    @relation(fields: [majorId], references: [id], onDelete: Cascade, onUpdate: Cascade) // ข้อมูลสาขา
    activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Cascade) // ข้อมูลกิจกรรม

    @@unique([majorId, activityId])
    @@index([majorId])
    @@index([activityId])
    @@map("major_join_activities")
}

model Activity {
    id             String         @id @default(uuid()) @db.Uuid // รหัสกิจกรรม (UUID)
    name           String // ชื่อกิจกรรม
    typeActivityId String         @map("type_activity_id") @db.Uuid // รหัสประเภทกิจกรรม
    typeActivity   TypeActivity   @relation(fields: [typeActivityId], references: [id], onDelete: Restrict, onUpdate: Cascade) // ข้อมูลประเภทกิจกรรม
    description    String?        @db.Text // รายละเอียดกิจกรรม
    date           DateTime // วันที่จัดกิจกรรม
    address        String // สถานที่จัดกิจกรรม
    departmentId   String         @map("department_id") @db.Uuid // รหัสแผนกที่จัดกิจกรรม
    responsibleId  String         @map("responsible_id") @db.Uuid // รหัสผู้รับผิดชอบ (พนักงาน)
    peopleCount    Int?           @map("people_count") // จำนวนผู้เข้าร่วม
    maxPeopleCount Int?           @map("max_people_count") // จำนวนผู้เข้าร่วมสูงสุด
    hour           Int? // จำนวนชั่วโมงกิจกรรม
    status         ActivityStatus @default(planned) // สถานะกิจกรรม
    createdAt      DateTime       @default(now()) @map("created_at") // วันที่สร้าง
    updatedAt      DateTime       @updatedAt @map("updated_at") // วันที่แก้ไขล่าสุด
    department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade) // ข้อมูลแผนก
    responsible    User           @relation(fields: [responsibleId], references: [id], onDelete: Restrict, onUpdate: Cascade) // ข้อมูลผู้รับผิดชอบ
    attendances    Attendance[] // ข้อมูลการเข้าร่วมกิจกรรม
    fileActivities FileActivity[] // ไฟล์ที่เกี่ยวข้องกับกิจกรรม
    majorJoins     MajorJoinActivity[] // สาขาที่เข้าร่วมกิจกรรม


    @@index([departmentId])
    @@index([responsibleId])
    @@index([status])
    @@index([date])
    @@index([typeActivityId])
    @@map("activities")
}

model FileActivity {
    id         String   @id @default(uuid()) @db.Uuid // รหัสไฟล์กิจกรรม (UUID)
    activityId String   @map("activity_id") @db.Uuid // รหัสกิจกรรมที่ไฟล์นี้เกี่ยวข้อง
    filepath   String // ชื่อไฟล์/ที่อยู่ไฟล์
    createdAt  DateTime @default(now()) @map("created_at") // วันที่อัพโหลดไฟล์
    activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Cascade) // ข้อมูลกิจกรรม

    @@index([activityId])
    @@map("file_activities")
}

model Log {
    id          String   @id @default(uuid()) @db.Uuid // รหัส log (UUID)
    action      String // กิจกรรมที่ทำ (action)
    fullname    String // ชื่อผู้ทำรายการ
    role        String // บทบาทผู้ทำรายการ
    description String?  @db.Text // รายละเอียดเพิ่มเติม
    createdAt   DateTime @default(now()) @map("created_at") // วันที่บันทึก log

    @@index([action])
    @@index([createdAt])
    @@map("logs")
}

model Attendance {
    id         String           @id @default(uuid()) @db.Uuid // รหัสการเข้าร่วมกิจกรรม (UUID)
    userId     String           @map("user_id") @db.Uuid // รหัสผู้ใช้ที่เข้าร่วม (นักศึกษา)
    activityId String           @map("activity_id") @db.Uuid // รหัสกิจกรรมที่เข้าร่วม
    user       User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade) // ข้อมูลนักศึกษา
    activity   Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Cascade) // ข้อมูลกิจกรรม
    reason     String?          @db.Text // เหตุผลการเข้าร่วม/ไม่เข้าร่วม
    status     AttendanceStatus @default(joined) // สถานะการเข้าร่วม
    createdAt  DateTime         @default(now()) @map("created_at") // วันที่สร้าง
    updatedAt  DateTime         @updatedAt @map("updated_at") // วันที่แก้ไขล่าสุด

    @@unique([userId, activityId])
    @@index([userId])
    @@index([activityId])
    @@index([status])
    @@map("attendances")
}

enum UserType {
    admin
    teacher
    student
}

enum UserStatus {
    active
    inactive
    graduated
    expelled
    deleted
}

enum AttendanceStatus {
    joined
    accepted
    rejected
    Inprogress
    completed
    uncompleted
}

enum ActivityStatus {
    planned
    inprogress
    completed
    cancelled
}
