generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Department {
    id         String     @id @default(uuid()) @db.Uuid
    name       String
    shortName  String
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt
    Employees  Employee[]
    students   Student[]
    activities Activity[]
}

model Employee {
    id           String     @id @default(uuid()) @db.Uuid
    fullname     String
    email        String     @unique
    password     String
    phone        String?
    departmentId String?     @db.Uuid
    department   Department? @relation(fields: [departmentId], references: [id])
    role         Role       @default(teacher)
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt
    activities   Activity[]
}

model Student {
    id           String        @id 
    fullname     String
    departmentId String        @db.Uuid
    birthday     String
    email        String        @unique
    phone        String?
    profilePic   String?       
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    status       StudentStatus @default(active)
    attendances  Attendance[]
    department   Department    @relation(fields: [departmentId], references: [id])
}

model Activity {
    id             String         @id @default(uuid()) @db.Uuid
    name           String
    description    String?
    date           DateTime
    address        String
    departmentId   String         @db.Uuid
    employeeId     String         @db.Uuid
    peopleCount    Int?
    maxPeopleCount Int?
    fileActivity   String?
    hour           Int?
    status         ActivityStatus @default(planned)
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt
    department     Department     @relation(fields: [departmentId], references: [id])
    Employee       Employee       @relation(fields: [employeeId], references: [id])
    attendances    Attendance[]
}

model Log {
    id        String   @id @default(uuid()) @db.Uuid
    action    String
    fullname  String
    role      String
    description String?
    createdAt DateTime @default(now())
}

model Attendance {
    id         String           @id @default(uuid()) @db.Uuid
    studentId  String           
    activityId String           @db.Uuid
    student    Student          @relation(fields: [studentId], references: [id])
    activity   Activity         @relation(fields: [activityId], references: [id])
    reason     String?
    status     AttendanceStatus @default(joined)
    createdAt  DateTime         @default(now())
    updatedAt  DateTime         @updatedAt
}

enum Role {
    admin
    teacher
}

enum AttendanceStatus {
    joined
    accepted
    rejected
    Inprogress
    completed
    uncompleted
}

enum ActivityStatus {
    planned
    inprogress
    completed
    cancelled
}

enum StudentStatus {
    active
    graduated
    expelled
}
